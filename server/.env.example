# Postgres connection (matches docker-compose.yml)
DATABASE_URL=postgres://openscreentime:openscreentime@localhost:5432/openscreentime

# WebAuthn relying party. RP_ID must be the registrable domain of RP_ORIGIN.
# In dev the web control center runs on :5173 and proxies to the server.
RP_ID=localhost
RP_ORIGIN=http://localhost:5173

# Address the API + agent bus binds to.
BIND_ADDR=0.0.0.0:8080

# Public base URL of the control center (OIDC redirect URI + post-login
# redirects). Optional; falls back to RP_ORIGIN.
#OST_PUBLIC_URL=https://ost.example.com

# Session cookies are Secure by default. Set to 1 ONLY for plain-http dev.
#OST_INSECURE_COOKIES=1

# Set to 1 when running behind a reverse proxy so the rate limiter keys on the
# first X-Forwarded-For value instead of the peer address.
#OST_TRUST_PROXY=1

# OIDC SSO (e.g. Authentik). Off unless all three of ISSUER/CLIENT_ID/
# CLIENT_SECRET are set; endpoints are discovered at startup.
#OST_OIDC_ISSUER=https://auth.example.com/application/o/openscreentime/
#OST_OIDC_CLIENT_ID=openscreentime
#OST_OIDC_CLIENT_SECRET=change-me
#OST_OIDC_NAME=Authentik

# Log filter
RUST_LOG=openscreentime_server=debug,tower_http=info,info
