# Lightweight watchdog (TAMPER.md level 1): restart the agent if its heartbeat file
# goes stale. Driven by openscreentime-watchdog.timer. This is the "second lightweight
# unit" option; alternatively enable WatchdogSec in openscreentime-agent.service.
[Unit]
Description=Sentinel agent watchdog (restart on stale heartbeat)
After=openscreentime-agent.service

[Service]
Type=oneshot
# If the heartbeat file is older than 90s (or missing), kick the agent.
ExecStart=/bin/sh -c 'f=/run/openscreentime/heartbeat; if [ ! -e "$f" ] || [ "$(( $(date +%%s) - $(stat -c %%Y "$f" 2>/dev/null || echo 0) ))" -gt 90 ]; then systemctl restart openscreentime-agent.service; fi'
