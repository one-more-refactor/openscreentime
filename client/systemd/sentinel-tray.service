# Sentinel tray — per-user companion (transparency surface).
# Installed to /etc/systemd/user/sentinel-tray.service by `sentinel-agent install-service`
# (best-effort; requires a binary built with `--features tray`).
#
# This is a systemd USER unit: each desktop user opts in with
#   systemctl --user enable --now sentinel-tray
#
# It runs as the desktop user (never root), reads the world-readable status
# snapshot at /run/sentinel/status.json, and shows a StatusNotifierItem tray
# icon plus desktop notifications — including when a parent opens a remote
# shell on this device.
[Unit]
Description=Sentinel per-user tray companion
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sentinel-agent tray
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
