# OpenScreenTime — a throwaway "managed laptop" for end-to-end agent tests.
#
# A Debian container that boots systemd, runs dnsmasq + nftables, has two
# ordinary OS users (a kid and a parent) and sudo/polkit, and gets the
# HEADLESS agent binary mounted in. It lets you enroll a device against a real
# server, watch the WebSocket presence/lock/state machinery, verify the DNS
# sinkhole and the PAM parent-code path — all rootless on the dev box, no
# sudo needed on your own machine.
#
# What it cannot test: the desktop lockout overlay / tray (no display), and
# freezing real login sessions (there is no seat). Everything else is real.
#
#   deploy/test/run.sh build
#   deploy/test/run.sh up  <server-url> <enroll-token>
#   deploy/test/run.sh sh                 # shell inside
#   deploy/test/run.sh down
FROM docker.io/library/debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus libpam-systemd \
        dnsmasq nftables iproute2 iputils-ping procps psmisc \
        sudo policykit-1 ca-certificates curl jq less vim-tiny \
        libpam-modules libpam-runtime \
    && rm -rf /var/lib/apt/lists/* \
    # keep the container lean: no getty, no timesync
    && systemctl mask getty@tty1.service console-getty.service systemd-timesyncd.service \
    && systemctl enable dnsmasq \
    # an ordinary kid and a parent account, like a real family laptop
    && useradd -m -s /bin/bash -c "Kid Tester" kid \
    && useradd -m -s /bin/bash -c "Parent Tester" parent \
    && echo "kid:kid" | chpasswd && echo "parent:parent" | chpasswd \
    && usermod -aG sudo parent \
    # a plain static resolv.conf the agent can pin (no systemd-resolved here)
    && rm -f /etc/resolv.conf && printf 'nameserver 1.1.1.1\n' > /etc/resolv.conf \
    # dnsmasq: listen on loopback only, read the agent's drop-in dir
    && printf 'listen-address=127.0.0.1\nbind-interfaces\nno-resolv\nserver=1.1.1.1\nconf-dir=/etc/dnsmasq.d/,*.conf\n' > /etc/dnsmasq.conf
# the agent binary is bind-mounted at /usr/local/bin/openscreentime by run.sh
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
