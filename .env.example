# Sentinel — production environment for compose.yaml.
#
#   cp .env.example .env
#   $EDITOR .env
#
# compose.yaml reads this file automatically (podman-compose / docker compose
# both load .env from the directory they're invoked in).

# ---- Postgres ---------------------------------------------------------------
# Credentials for the bundled `db` service. Change the password; the rest can
# stay as-is unless you need to match an existing database.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=sentinel

# DATABASE_URL is derived automatically in compose.yaml from the three vars
# above (postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB).
# Only set it here yourself if you're pointing at an external Postgres
# instead of the bundled `db` service.
# DATABASE_URL=postgres://sentinel:change-me@db:5432/sentinel

# ---- Public-facing URLs -------------------------------------------------------
# These MUST be the external HTTPS URL of your reverse proxy (the thing the
# user's browser and WebAuthn actually talk to) — NOT the internal container
# address. See docs/DEPLOY.md for the reverse-proxy requirements.
RP_ID=sentinel.example.com
RP_ORIGIN=https://sentinel.example.com
# Defaults to RP_ORIGIN if unset; only set separately if the OIDC redirect
# and post-login URL should differ from the WebAuthn RP origin.
SENTINEL_PUBLIC_URL=https://sentinel.example.com

# ---- Host port ----------------------------------------------------------------
# The server container's port 8080 is published to 127.0.0.1:$SENTINEL_PORT
# on the HOST ONLY — your external reverse proxy running on the same host
# forwards to it. It is never exposed on a public interface directly.
SENTINEL_PORT=8080

# ---- Cookies --------------------------------------------------------------
# Leave UNSET in production (cookies must be Secure over HTTPS). Only set to
# 1 for local plain-http testing.
# SENTINEL_INSECURE_COOKIES=1

# ---- OIDC SSO (optional) -----------------------------------------------------
# Leave all three unset to disable OIDC (passkey-only login still works).
# SENTINEL_OIDC_ISSUER=https://issuer.example.com
# SENTINEL_OIDC_CLIENT_ID=sentinel
# SENTINEL_OIDC_CLIENT_SECRET=change-me
# SENTINEL_OIDC_NAME=SSO

# ---- Logging ------------------------------------------------------------------
# RUST_LOG=sentinel_server=info,tower_http=info,info
