# OpenScreenTime — production environment for compose.yaml.
#
#   cp .env.example .env
#   $EDITOR .env
#
# compose.yaml reads this file automatically (podman-compose / docker compose
# both load .env from the directory they're invoked in).

# ---- Postgres ---------------------------------------------------------------
# Credentials for the bundled `db` service. Change the password; the rest can
# stay as-is unless you need to match an existing database.
POSTGRES_USER=openscreentime
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=openscreentime

# DATABASE_URL is derived automatically in compose.yaml from the three vars
# above (postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB).
# Only set it here yourself if you're pointing at an external Postgres
# instead of the bundled `db` service.
# DATABASE_URL=postgres://openscreentime:change-me@db:5432/openscreentime

# ---- Public-facing URLs -------------------------------------------------------
# These MUST be the external HTTPS URL of your reverse proxy (the thing the
# user's browser and WebAuthn actually talk to) — NOT the internal container
# address. See docs/DEPLOY.md for the reverse-proxy requirements.
RP_ID=ost.example.com
RP_ORIGIN=https://ost.example.com
# Defaults to RP_ORIGIN if unset; only set separately if the OIDC redirect
# and post-login URL should differ from the WebAuthn RP origin.
OST_PUBLIC_URL=https://ost.example.com

# ---- Host port ----------------------------------------------------------------
# The server container's port 8080 is published to $OST_BIND_ADDR:$OST_PORT on
# the HOST ONLY — your external reverse proxy forwards to it. It is never
# exposed on a public interface directly.
OST_PORT=8080

# Which host address to publish on. The default (127.0.0.1) is right when the
# reverse proxy runs on this same machine. If the proxy lives on a DIFFERENT
# host, set this to the LAN/VPN address it can reach — e.g. 192.168.8.131.
#
# Never set it to 0.0.0.0. The server trusts X-Forwarded-For (see
# OST_TRUST_PROXY below), so anyone who can reach this port directly can hand
# it any client IP they like and walk straight past the rate limiter.
# OST_BIND_ADDR=127.0.0.1

# ---- Reverse proxy trust ----------------------------------------------------
# Defaults to 1: rate limiting keys clients by the last X-Forwarded-For hop
# your proxy appends. Only set to 0 if you expose the app port directly
# without any reverse proxy (not the supported production layout).
# OST_TRUST_PROXY=1

# ---- Cookies --------------------------------------------------------------
# Leave UNSET in production (cookies must be Secure over HTTPS). Only set to
# 1 for local plain-http testing.
# OST_INSECURE_COOKIES=1

# ---- OIDC SSO (optional) -----------------------------------------------------
# Leave all three unset to disable OIDC (passkey-only login still works).
# OST_OIDC_ISSUER=https://issuer.example.com
# OST_OIDC_CLIENT_ID=openscreentime
# OST_OIDC_CLIENT_SECRET=change-me
# OST_OIDC_NAME=SSO

# ---- Phone alerts (optional) -------------------------------------------------
# One-way chat-bot notifications on confirmed tamper / device lockdown and new
# time requests. OpenScreenTime only SENDS — it never reads anything back (no bot
# webhook, no polling). Configure either (or both); leave unset to disable.
#
# A Discord or Slack "incoming webhook" URL — the easiest option, just paste it:
# OST_ALERT_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy
#
# …or a Telegram bot (message @BotFather to make one; the chat id is where the
# messages go — your own chat with the bot, or a group's id):
# OST_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# OST_TELEGRAM_CHAT_ID=123456789

# ---- Logging ------------------------------------------------------------------
# RUST_LOG=openscreentime_server=info,tower_http=info,info
